# Server-side secrets for the Google Places proxy.
# Copy to .env.local for local development (gitignored); set the same variables
# in Vercel Project Settings -> Environment Variables for deployments.
# Never commit real values.

# Google Places API key (server-only, never NEXT_PUBLIC_).
# Used by lib/googlePlaces.js, pages/api/get-place-photo.js, pages/api/download-photo.js.
GOOGLE_PLACES_API_KEY=

# Shared secret required by the Places proxy API routes.
# Callers must send it as the "x-places-secret" header.
# Generate with: openssl rand -hex 32
# If unset, both proxy routes reject every request (fail closed).
PLACES_PROXY_SECRET=
